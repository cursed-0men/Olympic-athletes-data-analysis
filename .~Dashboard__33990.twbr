      <column caption='Era' datatype='string' name='[Calculation_2335779301888001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF YEAR([born_date]) &lt; 1950 THEN &quot;Early Era&quot;&#10;ELSEIF YEAR([born_date]) &lt; 1980 THEN &quot;Mid Era&quot;&#10;ELSE &quot;Modern Era&quot;&#10;END' />
